  <regions>
    <region region-id="101" left="12" top="0" width="490" height="19" align-x="12" align-y="12" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Heading 1" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">КОМПЛЕКСНЫЕ ЧИСЛА</p>
      </text>
    </region>
    <region region-id="102" left="12" top="27" width="490" height="19" align-x="12" align-y="39" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Расчётная работа • вариант 24</p>
      </text>
    </region>
    <region region-id="103" left="12" top="65" width="490" height="19" align-x="12" align-y="77" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Heading 2" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">1. Геометрия и формы записи числа</p>
      </text>
    </region>
    <region region-id="104" left="12" top="100" width="480" height="30" align-x="12" align-y="112" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">N</ml:id>
          <ml:real>24</ml:real>
        </ml:define>
      </math>
    </region>
    <region region-id="105" left="150" top="100" width="480" height="30" align-x="150" align-y="112" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">a</ml:id>
          <ml:real>-1.5</ml:real>
        </ml:define>
      </math>
    </region>
    <region region-id="106" left="300" top="100" width="480" height="30" align-x="300" align-y="112" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">b</ml:id>
          <ml:real>1</ml:real>
        </ml:define>
      </math>
    </region>
    <region region-id="107" left="12" top="138" width="480" height="30" align-x="12" align-y="150" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">z</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">a</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:imag symbol="i">1</ml:imag>
                <ml:id xml:space="preserve">b</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="108" left="12" top="180" width="480" height="30" align-x="12" align-y="192" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:eval placeholderMultiplicationStyle="default">
          <ml:apply>
            <ml:id xml:space="preserve">Re</ml:id>
            <ml:id xml:space="preserve">z</ml:id>
          </ml:apply>
          <ml:result>
            <ml:real>-1.5</ml:real>
          </ml:result>
        </ml:eval>
      </math>
    </region>
    <region region-id="109" left="240" top="180" width="480" height="30" align-x="240" align-y="192" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:eval placeholderMultiplicationStyle="default">
          <ml:apply>
            <ml:id xml:space="preserve">Im</ml:id>
            <ml:id xml:space="preserve">z</ml:id>
          </ml:apply>
          <ml:result>
            <ml:real>1</ml:real>
          </ml:result>
        </ml:eval>
      </math>
    </region>
    <region region-id="110" left="12" top="218" width="480" height="30" align-x="12" align-y="230" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">r</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:absval />
              <ml:id xml:space="preserve">z</ml:id>
            </ml:apply>
            <ml:result>
              <ml:real>1.8027756377319946</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="111" left="12" top="258" width="480" height="30" align-x="12" align-y="270" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">φ</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:id xml:space="preserve">arg</ml:id>
              <ml:id xml:space="preserve">z</ml:id>
            </ml:apply>
            <ml:result>
              <ml:real>2.5535900500422257</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="112" left="12" top="296" width="490" height="34" align-x="12" align-y="308" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Число находится во II четверти: φ = π − arctan(2/3).</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Главное значение аргумента: 146,309932°. Все аргументы: φ + 2πk, k ∈ ℤ.</p>
      </text>
    </region>
    <region region-id="113" left="12" top="330" width="480" height="30" align-x="12" align-y="342" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">zt</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:mult />
              <ml:id xml:space="preserve">r</ml:id>
              <ml:parens>
                <ml:apply>
                  <ml:plus />
                  <ml:apply>
                    <ml:id xml:space="preserve">cos</ml:id>
                    <ml:id xml:space="preserve">φ</ml:id>
                  </ml:apply>
                  <ml:apply>
                    <ml:mult />
                    <ml:imag symbol="i">1</ml:imag>
                    <ml:apply>
                      <ml:id xml:space="preserve">sin</ml:id>
                      <ml:id xml:space="preserve">φ</ml:id>
                    </ml:apply>
                  </ml:apply>
                </ml:apply>
              </ml:parens>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="114" left="12" top="365" width="480" height="30" align-x="12" align-y="377" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">ze</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:mult />
              <ml:id xml:space="preserve">r</ml:id>
              <ml:apply>
                <ml:pow />
                <ml:id xml:space="preserve">e</ml:id>
                <ml:apply>
                  <ml:mult />
                  <ml:imag symbol="i">1</ml:imag>
                  <ml:id xml:space="preserve">φ</ml:id>
                </ml:apply>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="115" left="12" top="400" width="490" height="19" align-x="12" align-y="412" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">На плоскости: вектор из начала координат в точку (−1,5; 1).</p>
      </text>
    </region>
    <region region-id="116" left="12" top="425" width="480" height="42" align-x="12" align-y="437" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">Xp</ml:id>
          <ml:matrix rows="2" cols="1">
            <ml:real>0</ml:real>
            <ml:id xml:space="preserve">a</ml:id>
          </ml:matrix>
        </ml:define>
      </math>
    </region>
    <region region-id="117" left="110" top="425" width="480" height="42" align-x="110" align-y="437" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">Yp</ml:id>
          <ml:matrix rows="2" cols="1">
            <ml:real>0</ml:real>
            <ml:id xml:space="preserve">b</ml:id>
          </ml:matrix>
        </ml:define>
      </math>
    </region>
    <region region-id="118" left="12" top="510" width="490" height="64" align-x="12" align-y="522" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Re z = −1,5</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Im z = 1</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">|z| = 1,802776</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">φ = 146,309932°</p>
      </text>
    </region>
    <region region-id="119" left="120" top="460" width="285" height="245" align-x="120" align-y="472" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <plot disable-calc="false" item-idref="201" />
    </region>
    <region region-id="120" left="12" top="762" width="490" height="19" align-x="12" align-y="774" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Heading 2" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">2. Арифметические действия</p>
      </text>
    </region>
    <region region-id="121" left="12" top="797" width="490" height="49" align-x="12" align-y="809" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Пусть z₁ = a + bi, z₂ = c + di. При сложении и вычитании складываем</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">соответствующие части; при умножении используем i² = −1.</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">При делении умножаем числитель и знаменатель на c − di.</p>
      </text>
    </region>
    <region region-id="122" left="12" top="860" width="480" height="30" align-x="12" align-y="872" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">c</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">a</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:real>0.1</ml:real>
                <ml:id xml:space="preserve">N</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:real>0.9</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="123" left="12" top="898" width="480" height="30" align-x="12" align-y="910" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">d</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:minus />
              <ml:id xml:space="preserve">b</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:real>0.1</ml:real>
                <ml:id xml:space="preserve">N</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:real>-1.4</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="124" left="12" top="936" width="480" height="30" align-x="12" align-y="948" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">z1</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:id xml:space="preserve">z</ml:id>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="125" left="12" top="974" width="480" height="30" align-x="12" align-y="986" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">z2</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">c</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:imag symbol="i">1</ml:imag>
                <ml:id xml:space="preserve">d</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>0.9</ml:real>
                <ml:imag>-1.4</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="126" left="12" top="1014" width="490" height="19" align-x="12" align-y="1026" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Сумма: z₁ + z₂ = (a + c) + i(b + d).</p>
      </text>
    </region>
    <region region-id="127" left="12" top="1040" width="480" height="30" align-x="12" align-y="1052" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">S</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">z1</ml:id>
              <ml:id xml:space="preserve">z2</ml:id>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-0.6</ml:real>
                <ml:imag>-0.3999999999999999</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="128" left="12" top="1083" width="490" height="19" align-x="12" align-y="1095" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Разность: z₁ − z₂ = (a − c) + i(b − d).</p>
      </text>
    </region>
    <region region-id="129" left="12" top="1109" width="480" height="30" align-x="12" align-y="1121" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">D</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:minus />
              <ml:id xml:space="preserve">z1</ml:id>
              <ml:id xml:space="preserve">z2</ml:id>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-2.4</ml:real>
                <ml:imag>2.4</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="130" left="12" top="1152" width="490" height="19" align-x="12" align-y="1164" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Произведение: z₁z₂ = (ac − bd) + i(ad + bc).</p>
      </text>
    </region>
    <region region-id="131" left="12" top="1178" width="480" height="30" align-x="12" align-y="1190" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">Prod</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:mult />
              <ml:id xml:space="preserve">z1</ml:id>
              <ml:id xml:space="preserve">z2</ml:id>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>0.04999999999999982</ml:real>
                <ml:imag>2.9999999999999996</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="132" left="12" top="1221" width="490" height="34" align-x="12" align-y="1233" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Частное: z₁/z₂ = [(ac + bd) + i(bc − ad)] / (c² + d²).</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Знаменатель отличен от нуля, поскольку z₂ ≠ 0.</p>
      </text>
    </region>
    <region region-id="133" left="12" top="1265" width="480" height="40" align-x="12" align-y="1277" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">Q</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:div />
              <ml:id xml:space="preserve">z1</ml:id>
              <ml:id xml:space="preserve">z2</ml:id>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-0.9927797833935018</ml:real>
                <ml:imag>-0.43321299638989164</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="134" left="12" top="1319" width="490" height="49" align-x="12" align-y="1331" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Точные результаты:</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">S = −3/5 − (2/5)i;     D = −12/5 + (12/5)i;</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Prod = 1/20 + 3i;     Q = −275/277 − (120/277)i.</p>
      </text>
    </region>
    <region region-id="135" left="12" top="1524" width="490" height="19" align-x="12" align-y="1536" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Heading 2" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">3. Сопряжение, обратное число и коллинеарность</p>
      </text>
    </region>
    <region region-id="136" left="12" top="1566" width="480" height="30" align-x="12" align-y="1578" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">zc</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:minus />
              <ml:id xml:space="preserve">a</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:imag symbol="i">1</ml:imag>
                <ml:id xml:space="preserve">b</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>-1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="137" left="12" top="1607" width="480" height="38" align-x="12" align-y="1619" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">zi</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:div />
              <ml:real>1</ml:real>
              <ml:id xml:space="preserve">z</ml:id>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-0.46153846153846156</ml:real>
                <ml:imag>-0.3076923076923077</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="138" left="12" top="1653" width="490" height="64" align-x="12" align-y="1665" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Обозначим O = (0; 0), A = (−3/2; 1), B = (−3/2; −1),</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">C = (−6/13; −4/13). Это точки 0, z, сопряжённого z и 1/z.</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Для точек O, B и C выполняется одно уравнение y = (2/3)x.</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Кроме того, C = (4/13)B, поэтому O, B, C лежат на одной прямой.</p>
      </text>
    </region>
    <region region-id="139" left="12" top="1730" width="490" height="79" align-x="12" align-y="1742" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Проверка остальных троек по ориентированной удвоенной площади:</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Δ(O,A,B) = (−3/2)(−1) − 1(−3/2) = 3 ≠ 0;</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Δ(O,A,C) = (−3/2)(−4/13) − 1(−6/13) = 12/13 ≠ 0;</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Δ(A,B,C) = 0·(−17/13) − (−2)·(27/26) = 27/13 ≠ 0.</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Ответ: единственная коллинеарная тройка — 0, сопряжённое z, 1/z.</p>
      </text>
    </region>
    <region region-id="140" left="12" top="1834" width="480" height="70" align-x="12" align-y="1846" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">Xc</ml:id>
          <ml:matrix rows="4" cols="1">
            <ml:real>0</ml:real>
            <ml:real>-0.46153846153846156</ml:real>
            <ml:id xml:space="preserve">a</ml:id>
            <ml:id xml:space="preserve">a</ml:id>
          </ml:matrix>
        </ml:define>
      </math>
    </region>
    <region region-id="141" left="150" top="1834" width="480" height="70" align-x="150" align-y="1846" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">Yc</ml:id>
          <ml:matrix rows="4" cols="1">
            <ml:real>0</ml:real>
            <ml:real>-0.3076923076923077</ml:real>
            <ml:apply>
              <ml:neg />
              <ml:id xml:space="preserve">b</ml:id>
            </ml:apply>
            <ml:id xml:space="preserve">b</ml:id>
          </ml:matrix>
        </ml:define>
      </math>
    </region>
    <region region-id="142" left="120" top="1924" width="285" height="245" align-x="120" align-y="1936" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <plot disable-calc="false" item-idref="202" />
    </region>
    <region region-id="143" left="12" top="2228" width="490" height="19" align-x="12" align-y="2240" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Ломаная соединяет O → C → B → A; первые три точки лежат на прямой.</p>
      </text>
    </region>
    <region region-id="144" left="12" top="2286" width="490" height="19" align-x="12" align-y="2298" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Heading 2" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">4. Все корни 29-й степени</p>
      </text>
    </region>
    <region region-id="145" left="12" top="2324" width="480" height="30" align-x="12" align-y="2336" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">n</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">N</ml:id>
              <ml:real>5</ml:real>
            </ml:apply>
            <ml:result>
              <ml:real>29</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="146" left="12" top="2364" width="480" height="38" align-x="12" align-y="2376" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">ρ</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:pow />
              <ml:id xml:space="preserve">r</ml:id>
              <ml:apply>
                <ml:div />
                <ml:real>1</ml:real>
                <ml:id xml:space="preserve">n</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:real>1.0205295281866922</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="147" left="12" top="2411" width="490" height="34" align-x="12" align-y="2423" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Формула Муавра: wₖ = ρ[cos((φ + 2πk)/n) + i sin((φ + 2πk)/n)].</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Здесь k = 0, 1, …, 28. Углы отсчитываются от положительной вещественной оси.</p>
      </text>
    </region>
    <region region-id="148" left="12" top="2456" width="480" height="30" align-x="12" align-y="2468" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">k</ml:id>
          <ml:range>
            <ml:real>0</ml:real>
            <ml:apply>
              <ml:minus />
              <ml:id xml:space="preserve">n</ml:id>
              <ml:real>1</ml:real>
            </ml:apply>
          </ml:range>
        </ml:define>
      </math>
    </region>
    <region region-id="149" left="12" top="2491" width="480" height="40" align-x="12" align-y="2503" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:apply>
            <ml:indexer />
            <ml:id xml:space="preserve">θ</ml:id>
            <ml:id xml:space="preserve">k</ml:id>
          </ml:apply>
          <ml:apply>
            <ml:div />
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">φ</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:apply>
                  <ml:mult />
                  <ml:real>2</ml:real>
                  <ml:id xml:space="preserve">π</ml:id>
                </ml:apply>
                <ml:id xml:space="preserve">k</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:id xml:space="preserve">n</ml:id>
          </ml:apply>
        </ml:define>
      </math>
    </region>
    <region region-id="150" left="12" top="2536" width="480" height="38" align-x="12" align-y="2548" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:apply>
            <ml:indexer />
            <ml:id xml:space="preserve">Xr</ml:id>
            <ml:id xml:space="preserve">k</ml:id>
          </ml:apply>
          <ml:apply>
            <ml:mult />
            <ml:id xml:space="preserve">ρ</ml:id>
            <ml:apply>
              <ml:id xml:space="preserve">cos</ml:id>
              <ml:apply>
                <ml:indexer />
                <ml:id xml:space="preserve">θ</ml:id>
                <ml:id xml:space="preserve">k</ml:id>
              </ml:apply>
            </ml:apply>
          </ml:apply>
        </ml:define>
      </math>
    </region>
    <region region-id="151" left="12" top="2581" width="480" height="38" align-x="12" align-y="2593" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:apply>
            <ml:indexer />
            <ml:id xml:space="preserve">Yr</ml:id>
            <ml:id xml:space="preserve">k</ml:id>
          </ml:apply>
          <ml:apply>
            <ml:mult />
            <ml:id xml:space="preserve">ρ</ml:id>
            <ml:apply>
              <ml:id xml:space="preserve">sin</ml:id>
              <ml:apply>
                <ml:indexer />
                <ml:id xml:space="preserve">θ</ml:id>
                <ml:id xml:space="preserve">k</ml:id>
              </ml:apply>
            </ml:apply>
          </ml:apply>
        </ml:define>
      </math>
    </region>
    <region region-id="152" left="12" top="2628" width="480" height="38" align-x="12" align-y="2640" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:apply>
            <ml:indexer />
            <ml:id xml:space="preserve">w</ml:id>
            <ml:id xml:space="preserve">k</ml:id>
          </ml:apply>
          <ml:apply>
            <ml:plus />
            <ml:apply>
              <ml:indexer />
              <ml:id xml:space="preserve">Xr</ml:id>
              <ml:id xml:space="preserve">k</ml:id>
            </ml:apply>
            <ml:apply>
              <ml:mult />
              <ml:imag symbol="i">1</ml:imag>
              <ml:apply>
                <ml:indexer />
                <ml:id xml:space="preserve">Yr</ml:id>
                <ml:id xml:space="preserve">k</ml:id>
              </ml:apply>
            </ml:apply>
          </ml:apply>
        </ml:define>
      </math>
    </region>
    <region region-id="153" left="120" top="2680" width="285" height="245" align-x="120" align-y="2692" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <plot disable-calc="false" item-idref="203" />
    </region>
    <region region-id="154" left="12" top="2990" width="490" height="49" align-x="12" align-y="3002" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Все 29 значений расположены на окружности |w| = 1,020529528.</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Соседние углы отличаются на 2π/29 ≈ 12,413793°. Повторов нет.</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Проверка: wₖ²⁹ = r·exp(i(φ + 2πk)) = z для каждого k.</p>
      </text>
    </region>
    <region region-id="155" left="12" top="3048" width="490" height="19" align-x="12" align-y="3060" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Heading 2" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Таблица всех значений корня</p>
      </text>
    </region>
    <region region-id="156" left="12" top="3083" width="490" height="19" align-x="12" align-y="3095" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Округление до 6 знаков; вычисления выше сохраняют полную точность.</p>
      </text>
    </region>
    <region region-id="157" left="12" top="3115" width="490" height="19" align-x="12" align-y="3127" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
