    <region region-id="106" left="300.0" top="100.0" width="480" height="30" align-x="300.0" align-y="112.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
