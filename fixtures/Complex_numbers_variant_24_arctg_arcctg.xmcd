    <region region-id="111" left="12" top="303" width="245" height="35" align-x="12" align-y="315" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">φ</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">π</ml:id>
              <ml:apply>
                <ml:id xml:space="preserve">arctg</ml:id>
                <ml:apply>
                  <ml:div />
                  <ml:id xml:space="preserve">b</ml:id>
                  <ml:id xml:space="preserve">a</ml:id>
                </ml:apply>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:real>2.5535900500422257</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="192" left="270" top="303" width="245" height="35" align-x="270" align-y="315" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">φc</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:id xml:space="preserve">arcctg</ml:id>
              <ml:apply>
                <ml:div />
                <ml:id xml:space="preserve">a</ml:id>
                <ml:id xml:space="preserve">b</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:real>2.5535900500422257</ml:real>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="112" left="12.0" top="341.0" width="490" height="34" align-x="12.0" align-y="353.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">II четверть: φ = π + arctg(b/a) = arcctg(a/b).</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Оба способа дают 146,309932°. Все аргументы: φ + 2πk, k ∈ ℤ.</p>
      </text>
    </region>
    <region region-id="113" left="12.0" top="375.0" width="480" height="30" align-x="12.0" align-y="387.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">zt</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:mult />
              <ml:id xml:space="preserve">r</ml:id>
              <ml:parens>
                <ml:apply>
                  <ml:plus />
                  <ml:apply>
                    <ml:id xml:space="preserve">cos</ml:id>
                    <ml:id xml:space="preserve">φ</ml:id>
                  </ml:apply>
                  <ml:apply>
                    <ml:mult />
                    <ml:imag symbol="i">1</ml:imag>
                    <ml:apply>
                      <ml:id xml:space="preserve">sin</ml:id>
                      <ml:id xml:space="preserve">φ</ml:id>
                    </ml:apply>
                  </ml:apply>
                </ml:apply>
              </ml:parens>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="114" left="12.0" top="410.0" width="480" height="30" align-x="12.0" align-y="422.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">ze</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:mult />
              <ml:id xml:space="preserve">r</ml:id>
              <ml:apply>
                <ml:pow />
                <ml:id xml:space="preserve">e</ml:id>
                <ml:apply>
                  <ml:mult />
                  <ml:imag symbol="i">1</ml:imag>
                  <ml:id xml:space="preserve">φ</ml:id>
                </ml:apply>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
      </math>
    </region>
    <region region-id="115" left="12.0" top="445.0" width="490" height="19" align-x="12.0" align-y="457.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">На плоскости: вектор из начала координат в точку (−1,5; 1).</p>
      </text>
    </region>
