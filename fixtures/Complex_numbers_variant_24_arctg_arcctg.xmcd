    </region>
    <region region-id="107" left="12.0" top="138.0" width="480" height="30" align-x="12.0" align-y="150.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:id xml:space="preserve">z</ml:id>
          <ml:eval placeholderMultiplicationStyle="default">
            <ml:apply>
              <ml:plus />
              <ml:id xml:space="preserve">a</ml:id>
              <ml:apply>
                <ml:mult />
                <ml:imag symbol="i">1</ml:imag>
                <ml:id xml:space="preserve">b</ml:id>
              </ml:apply>
            </ml:apply>
            <ml:result>
              <ml:complex>
                <ml:real>-1.5</ml:real>
                <ml:imag>1.0</ml:imag>
              </ml:complex>
            </ml:result>
          </ml:eval>
        </ml:define>
