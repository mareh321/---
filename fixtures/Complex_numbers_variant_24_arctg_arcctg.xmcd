    <region region-id="191" left="270" top="258" width="245" height="35" align-x="270" align-y="270" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <math optimize="false" disable-calc="false">
        <ml:define>
          <ml:apply>
            <ml:id xml:space="preserve">arcctg</ml:id>
            <ml:id xml:space="preserve">x</ml:id>
