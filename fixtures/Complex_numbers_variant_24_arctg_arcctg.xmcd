    <region region-id="174" left="562.0" top="2223.0" width="490" height="34" align-x="562.0" align-y="2235.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <text use-page-width="false" push-down="false" lock-width="true">
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">Итог: найдены характеристики числа, выполнены четыре действия,</p>
        <p style="Normal" margin-left="0" margin-right="0" text-indent="inherit" text-align="left" list-style-type="inherit" tabs="inherit">доказана коллинеарность тройки O, B, C и получены все 29 корней.</p>
      </text>
    </region>
